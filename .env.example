# --- Supabase / Postgres ---
# Pooled connection (PgBouncer, port 6543) - used by the app at runtime
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection (port 5432) - used by Prisma migrations only
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"

# --- Local admin dashboard (/admin — disabled on Vercel) ---
# Your Supabase auth user UUID. Restricts /admin to this user in local dev.
# EUCLIS_ADMIN_USER_ID="your-user-uuid"

# --- App URL (deep links in WhatsApp, MCP, etc.) ---
# Local: http://localhost:3000
# Production: https://euclis.dev
# On Vercel, VERCEL_PROJECT_PRODUCTION_URL is used automatically if this is unset.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Google Analytics (GA4) — loaded in production only ---
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-WW99N6L4N9"
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_..."

# --- In-app assistant (floating chat on dashboard) ---
# APP_CHAT_MODEL="claude-haiku-4-5"

# --- Anthropic (WhatsApp webhook + decision-memory capture) ---
ANTHROPIC_API_KEY="sk-ant-..."

# --- Decision memory (docs/decision-memory.md) ---
# Classifier model for capturing decisions/blockers from task updates
# MEMORY_CAPTURE_MODEL="claude-haiku-4-5"
# Kill switch: set to 0 to disable memory capture entirely
# MEMORY_CAPTURE="1"

# --- Embeddings for semantic task search (Phase A retrieval) ---
# Use OpenRouter OR OpenAI — OpenRouter is checked first if both are set.
OPENROUTER_API_KEY="sk-or-..."
# OPENAI_API_KEY="sk-..."
# Optional override (OpenRouter default: openai/text-embedding-3-small)
# EMBEDDING_MODEL="openai/text-embedding-3-small"

# --- Meta WhatsApp Cloud API ---
# Any random string you choose; must match what you enter in the Meta dashboard
WHATSAPP_VERIFY_TOKEN="choose-a-random-string"
# Permanent (or temporary test) access token from the Meta app dashboard
WHATSAPP_ACCESS_TOKEN="EAAG..."
# Phone number ID (NOT the phone number itself) from the WhatsApp API setup page
WHATSAPP_PHONE_NUMBER_ID="123456789012345"
# Test bot number users message (from WhatsApp > API Setup; E.164 digits, no + or spaces)
NEXT_PUBLIC_WHATSAPP_BOT_NUMBER="15551234567"
# App Secret (Meta app dashboard > App settings > Basic) - used to verify webhook signatures
WHATSAPP_APP_SECRET="<meta-app-secret>"
# Set to 1 to log every webhook step in the terminal (auto-on in dev; off in production)
WHATSAPP_WEBHOOK_DEBUG="1"
# Optional: Sonnet rewrites the final reply for a more natural tone (Haiku still runs tools)
# WHATSAPP_SONNET_POLISH="1"
# WHATSAPP_SONNET_MODEL="claude-sonnet-4-5"
# Multi-step orchestrator: triage (OpenRouter/Gemini) → simple|Haiku|Sonnet → judge
# WHATSAPP_ORCHESTRATOR="1"
# WHATSAPP_JUDGE="1"
# WHATSAPP_TRIAGE_MODEL="google/gemini-2.5-flash"
# WHATSAPP_JUDGE_MODEL="google/gemini-2.5-flash"
# WHATSAPP_SIMPLE_MODEL="claude-haiku-4-5"
# WHATSAPP_COMPLEX_MODEL="claude-sonnet-4-5"
# WHATSAPP_ASK_TASK_SUMMARIZE="1"
# WHATSAPP_SUMMARIZE_MODEL uses WHATSAPP_COMPLEX_MODEL (claude-sonnet-4-5)
# Deferred tool loading via Anthropic tool search (default on; set 0 to send all 35 tools every turn)
# WHATSAPP_TOOL_SEARCH="1"
