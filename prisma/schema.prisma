generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  LEADER
  SUB_LEADER
  MEMBER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TaskScope {
  FRONTEND
  BACKEND
  DESIGN
  GENERAL
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

/// Identity (passwords, OAuth) lives in Supabase Auth (auth.users).
/// This table is the app profile; its id mirrors auth.users.id, kept in
/// sync by the handle_new_user trigger (supabase/setup.sql).
model User {
  id            String  @id @default(uuid()) @db.Uuid
  email         String? @unique
  /// Unique handle shown across the UI instead of the email (lowercase a-z0-9_)
  username      String  @unique
  /// E.164 format (e.g. 91xxxxxxxxxx) - used to route incoming WhatsApp messages
  phone         String? @unique
  /// User-level secret for the Claude App Remote MCP connector
  mcpToken      String  @unique @default(uuid()) @db.Uuid
  lastIpAddress String?
  createdAt     DateTime @default(now())

  /// Pointer to the workspace the user most recently acted in.
  /// Kept up to date by the service layer; powers resolveUserWorkspaceContext.
  lastActiveWorkspaceId String?    @db.Uuid
  lastActiveWorkspace   Workspace? @relation("LastActiveWorkspace", fields: [lastActiveWorkspaceId], references: [id], onDelete: SetNull)

  memberships    WorkspaceMembership[]
  assignedTasks  Task[]                @relation("AssignedTasks")
  createdTasks   Task[]                @relation("CreatedTasks")
  uploadedAssets Asset[]
  oauthCodes     OAuthCode[]
  oauthTokens    OAuthToken[]
  whatsappMessages WhatsAppMessage[]
}

model Workspace {
  id              String   @id @default(uuid()) @db.Uuid
  name            String
  excalidrawState Json     @default("{}")
  createdAt       DateTime @default(now())

  memberships     WorkspaceMembership[]
  tasks           Task[]
  assets          Asset[]
  invites         WorkspaceInvite[]
  lastActiveUsers User[]                @relation("LastActiveWorkspace")
}

model WorkspaceMembership {
  userId      String   @db.Uuid
  workspaceId String   @db.Uuid
  role        Role     @default(MEMBER)
  joinedAt    DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([userId, workspaceId])
  @@index([workspaceId])
}

model Task {
  id          String     @id @default(uuid()) @db.Uuid
  /// Human-friendly ID, auto-incremented per workspace by the service layer
  /// (allocated as max(shortId)+1 inside a transaction; the unique constraint
  /// below guards against concurrent allocation races)
  shortId     Int
  workspaceId String       @db.Uuid
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  scope       TaskScope    @default(GENERAL)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?
  /// Free-form labels, editable from the task modal ("marketing", "v2", ...)
  tags        String[]     @default([])

  assignedToId String? @db.Uuid
  createdById  String? @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assignedTo  User?     @relation("AssignedTasks", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy   User?     @relation("CreatedTasks", fields: [createdById], references: [id], onDelete: SetNull)
  attachments Asset[]

  @@unique([workspaceId, shortId])
  @@index([workspaceId, status])
  @@index([assignedToId])
}

model Asset {
  id           String   @id @default(uuid()) @db.Uuid
  workspaceId  String   @db.Uuid
  /// Optional task attachment; asset stays in the workspace if the task goes
  taskId       String?  @db.Uuid
  url          String
  fileType     String
  tags         String[] @default([])
  uploadedById String   @db.Uuid
  createdAt    DateTime @default(now())

  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  task       Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)
  uploadedBy User      @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([taskId])
}

/// Meta wamid dedup — prevents webhook retries from re-running the same inbound message.
model WhatsAppInboundDedup {
  messageId String   @id
  createdAt DateTime @default(now())
}

/// One in-flight WhatsApp handler per phone — blocks duplicate user messages while processing.
model WhatsAppProcessingLock {
  phone     String   @id
  messageId String
  startedAt DateTime @default(now())
}

/// Per-phone FIFO queue — inbound messages wait here instead of running in parallel.
model WhatsAppInboundQueue {
  id        String   @id @default(uuid()) @db.Uuid
  phone     String
  messageId String   @unique
  kind      String
  payload   Json
  status    String   @default("pending")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([phone, status, createdAt])
}

/// Short-lived WhatsApp conversation history, so the bot can resolve
/// follow-up references ("make that one high priority"). Pruned per user;
/// only the recent window is ever sent to the model.
model WhatsAppMessage {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  /// "user" or "assistant"
  role      String
  content   String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// OAuth 2.1 authorization server models -- lets MCP clients (claude.ai web
/// and mobile connectors) authenticate users via the standard OAuth flow
/// instead of a manually copied bearer token.
model OAuthClient {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  redirectUris String[]
  createdAt    DateTime @default(now())

  codes  OAuthCode[]
  tokens OAuthToken[]
}

model OAuthCode {
  /// The authorization code handed to the client (single use, short lived)
  code          String   @id
  clientId      String   @db.Uuid
  userId        String   @db.Uuid
  redirectUri   String
  /// PKCE S256 challenge
  codeChallenge String
  expiresAt     DateTime
  createdAt     DateTime @default(now())

  client OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OAuthToken {
  /// Access token value (opaque random string)
  token        String    @id
  refreshToken String?   @unique
  clientId     String    @db.Uuid
  userId       String    @db.Uuid
  expiresAt    DateTime
  createdAt    DateTime  @default(now())

  client OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model WorkspaceInvite {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @db.Uuid
  maxUses     Int      @default(1)
  usesCount   Int      @default(0)
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}
