generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  LEADER
  SUB_LEADER
  MEMBER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum MemoryEventKind {
  DECISION
  BLOCKER
  DEPENDENCY
  MILESTONE
}

enum MemoryEventStatus {
  OPEN
  RESOLVED
}

/// Identity (passwords, OAuth) lives in Supabase Auth (auth.users).
/// This table is the app profile; its id mirrors auth.users.id, kept in
/// sync by the handle_new_user trigger (supabase/setup.sql).
model User {
  id            String  @id @default(uuid()) @db.Uuid
  email         String? @unique
  /// Unique handle shown across the UI instead of the email (lowercase a-z0-9_)
  username      String  @unique
  /// E.164 digits without + (country code + national number) — routes WhatsApp messages
  phone         String? @unique
  /// First inbound WhatsApp message from this user to the bot.
  whatsappChatInitiatedAt DateTime?
  /// User-level secret for the Claude App Remote MCP connector
  mcpToken      String  @unique @default(uuid()) @db.Uuid
  /// Tool scope for the mcpToken credential: "context" (read + memory +
  /// task updates, safe for coding agents) or "full" (complete registry).
  mcpScope      String  @default("context")
  /// When set, ALL MCP tool calls are pinned to this workspace — the
  /// workspace parameter is rejected if it points anywhere else.
  mcpWorkspaceId String?    @db.Uuid
  mcpWorkspace   Workspace? @relation("McpPinnedWorkspace", fields: [mcpWorkspaceId], references: [id], onDelete: SetNull)
  lastIpAddress String?
  createdAt     DateTime @default(now())

  /// Pointer to the workspace the user most recently acted in.
  /// Kept up to date by the service layer; powers resolveUserWorkspaceContext.
  lastActiveWorkspaceId String?    @db.Uuid
  lastActiveWorkspace   Workspace? @relation("LastActiveWorkspace", fields: [lastActiveWorkspaceId], references: [id], onDelete: SetNull)

  memberships    WorkspaceMembership[]
  taskAssignments TaskAssignee[]
  createdTasks   Task[]                @relation("CreatedTasks")
  taskUpdates    TaskUpdate[]
  uploadedAssets Asset[]
  createdLinks   WorkspaceLink[]
  oauthCodes     OAuthCode[]
  oauthTokens    OAuthToken[]
  memoryEvents   MemoryEvent[]         @relation("AuthoredMemoryEvents")
  whatsappMessages WhatsAppMessage[]
  whatsappPendingActions WhatsAppPendingAction[]
  whatsappChatState WhatsAppChatState?
  botActions BotActionLog[]
}

model Workspace {
  id              String   @id @default(uuid()) @db.Uuid
  name            String
  excalidrawState Json     @default("{}")
  createdAt       DateTime @default(now())

  memberships     WorkspaceMembership[]
  tasks           Task[]
  assets          Asset[]
  links           WorkspaceLink[]
  invites         WorkspaceInvite[]
  categories      WorkspaceCategory[]
  taskUpdates     TaskUpdate[]
  memoryEvents    MemoryEvent[]
  lastActiveUsers User[]                @relation("LastActiveWorkspace")
  mcpPinnedUsers  User[]                @relation("McpPinnedWorkspace")
}

/// Per-workspace task categories (defaults + custom labels).
model WorkspaceCategory {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @db.Uuid
  name        String
  slug        String
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks     Task[]

  @@unique([workspaceId, slug])
  @@index([workspaceId])
}

model WorkspaceMembership {
  userId      String   @db.Uuid
  workspaceId String   @db.Uuid
  role        Role     @default(MEMBER)
  joinedAt    DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([userId, workspaceId])
  @@index([workspaceId])
}

model Task {
  id          String     @id @default(uuid()) @db.Uuid
  /// Human-friendly ID, auto-incremented per workspace by the service layer
  /// (allocated as max(shortId)+1 inside a transaction; the unique constraint
  /// below guards against concurrent allocation races)
  shortId     Int
  workspaceId String       @db.Uuid
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  categoryId  String       @db.Uuid
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?
  /// Free-form labels, editable from the task modal ("marketing", "v2", ...)
  tags        String[]     @default([])

  createdById  String? @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  category    WorkspaceCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  assignees   TaskAssignee[]
  createdBy   User?     @relation("CreatedTasks", fields: [createdById], references: [id], onDelete: SetNull)
  attachments Asset[]
  updates     TaskUpdate[]
  embedding   TaskEmbedding?
  memoryEvents MemoryEvent[]

  @@unique([workspaceId, shortId])
  @@index([workspaceId, status])
  @@index([workspaceId, categoryId])
}

/// Semantic index for task retrieval (Phase A retrieval pipeline).
model TaskEmbedding {
  taskId      String   @id @db.Uuid
  workspaceId String   @db.Uuid
  /// SHA-256 of indexed document text — skip re-embed when unchanged.
  contentHash String
  /// OpenAI text-embedding-3-small vector (1536 dims) stored as JSON array.
  embedding   Json
  updatedAt   DateTime @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

/// Many-to-many: a task can have multiple assignees.
model TaskAssignee {
  taskId     String   @db.Uuid
  userId     String   @db.Uuid
  assignedAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId])
  @@index([taskId])
}

/// Per-task team updates — blockers, questions, review notes (not the static description).
model TaskUpdate {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @db.Uuid
  taskId      String   @db.Uuid
  authorId    String   @db.Uuid
  body        String
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  embedding TaskUpdateEmbedding?
  memoryEvents MemoryEvent[] @relation("MemoryEventSource")

  @@index([taskId, createdAt])
  @@index([workspaceId, createdAt])
}

/// Structured decision-memory record — a discrete "moment worth remembering"
/// (decision, blocker, dependency, milestone) extracted from team activity.
/// Standalone by design: sourceUpdateId is optional provenance so memory can
/// later ingest from sources other than Euclis task threads.
model MemoryEvent {
  id          String            @id @default(uuid()) @db.Uuid
  workspaceId String            @db.Uuid
  /// Optional — workspace-level decisions have no task.
  taskId      String?           @db.Uuid
  /// TaskUpdate this event was extracted from (provenance).
  sourceUpdateId String?        @db.Uuid
  kind        MemoryEventKind
  /// OPEN is only meaningful for BLOCKER/DEPENDENCY; decisions and
  /// milestones are created RESOLVED (they're facts, not open work).
  status      MemoryEventStatus @default(OPEN)
  /// One line: what happened.
  summary     String
  /// Why — the answer to a future "why was X decided".
  reasoning   String?
  authorId    String?           @db.Uuid

  resolvedAt         DateTime?
  resolvedByUpdateId String?   @db.Uuid
  resolvedById       String?   @db.Uuid

  /// Decisions evolve: a contradicting decision links the old one here
  /// (never deleted) so recall can walk the "why it changed" chain.
  supersededByEventId String?  @db.Uuid

  /// Semantic index over summary+reasoning (same JSON-vector pattern as
  /// TaskEmbedding). Null until the fire-and-forget embed job runs.
  embedding   Json?
  contentHash String?

  /// Resolution-suggestion throttling (confirm-only flow, never auto-ask
  /// more than twice, never again after a decline).
  lastSuggestedAt        DateTime?
  suggestionCount        Int       @default(0)
  suggestionsSuppressed  Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace    Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  task         Task?       @relation(fields: [taskId], references: [id], onDelete: SetNull)
  sourceUpdate TaskUpdate? @relation("MemoryEventSource", fields: [sourceUpdateId], references: [id], onDelete: SetNull)
  author       User?       @relation("AuthoredMemoryEvents", fields: [authorId], references: [id], onDelete: SetNull)
  supersededBy MemoryEvent?  @relation("MemoryEventSupersession", fields: [supersededByEventId], references: [id], onDelete: SetNull)
  supersedes   MemoryEvent[] @relation("MemoryEventSupersession")

  @@index([workspaceId, status, kind])
  @@index([taskId, createdAt])
  @@index([workspaceId, createdAt])
}

/// Semantic index for task update RAG (Phase B).
model TaskUpdateEmbedding {
  taskUpdateId String   @id @db.Uuid
  workspaceId  String   @db.Uuid
  taskId       String   @db.Uuid
  contentHash  String
  embedding    Json
  updatedAt    DateTime @updatedAt

  taskUpdate TaskUpdate @relation(fields: [taskUpdateId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([workspaceId])
}

model Asset {
  id           String   @id @default(uuid()) @db.Uuid
  workspaceId  String   @db.Uuid
  /// Optional task attachment; asset stays in the workspace if the task goes
  taskId       String?  @db.Uuid
  url          String
  fileType     String
  tags         String[] @default([])
  uploadedById String   @db.Uuid
  createdAt    DateTime @default(now())

  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  task       Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)
  uploadedBy User      @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([taskId])
}

/// Workspace-wide bookmarks — shared URLs for the whole team.
model WorkspaceLink {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @db.Uuid
  title       String
  url         String
  description String?
  pinned      Boolean  @default(false)
  createdById String   @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User      @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

/// Meta wamid dedup — prevents webhook retries from re-running the same inbound message.
model WhatsAppInboundDedup {
  messageId String   @id
  createdAt DateTime @default(now())
}

/// One in-flight WhatsApp handler per phone — blocks duplicate user messages while processing.
model WhatsAppProcessingLock {
  phone     String   @id
  messageId String
  startedAt DateTime @default(now())
}

/// Per-phone FIFO queue — inbound messages wait here instead of running in parallel.
model WhatsAppInboundQueue {
  id        String   @id @default(uuid()) @db.Uuid
  phone     String
  messageId String   @unique
  kind      String
  payload   Json
  status    String   @default("pending")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([phone, status, createdAt])
}

/// Short-lived WhatsApp conversation history, so the bot can resolve
/// follow-up references ("make that one high priority"). Pruned per user;
/// only the recent window is ever sent to the model.
model WhatsAppMessage {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  /// "user" or "assistant"
  role      String
  content   String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// Journal of reversible bot actions — powers "undo that" in chat.
/// Each row stores a typed inverse payload (lib/services/action-log.ts);
/// undo executes the inverse and stamps undoneAt. Rows expire by window,
/// not deletion, so the journal doubles as a recent-action audit trail.
model BotActionLog {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  workspaceId String    @db.Uuid
  /// "whatsapp" | "mcp"
  channel     String
  tool        String
  /// User-facing line describing the original action, e.g. Added *X*
  summary     String
  /// Typed inverse payload — see UndoInverse union in the service.
  inverse     Json
  undoneAt    DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, workspaceId, createdAt])
}

/// Rolling WhatsApp chat state — the task the user last discussed, so
/// follow-ups ("post that", "mark it done") resolve deterministically
/// instead of being re-parsed out of previous bot replies.
model WhatsAppChatState {
  userId          String   @id @db.Uuid
  /// Task shortId last referenced in chat; only valid within workspaceId.
  lastTaskShortId Int?
  workspaceId     String?  @db.Uuid
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Short-lived pending confirmation (e.g. delete task) — one per phone.
model WhatsAppPendingAction {
  phone     String   @id
  userId    String   @db.Uuid
  action    String
  payload   Json
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

/// OAuth 2.1 authorization server models -- lets MCP clients (claude.ai web
/// and mobile connectors) authenticate users via the standard OAuth flow
/// instead of a manually copied bearer token.
model OAuthClient {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  redirectUris String[]
  createdAt    DateTime @default(now())

  codes  OAuthCode[]
  tokens OAuthToken[]
}

model OAuthCode {
  /// The authorization code handed to the client (single use, short lived)
  code          String   @id
  clientId      String   @db.Uuid
  userId        String   @db.Uuid
  redirectUri   String
  /// PKCE S256 challenge
  codeChallenge String
  /// Connection choices made on the consent screen, carried onto the token:
  scope         String   @default("context")
  /// Workspace this connection is confined to; null = all workspaces.
  workspaceId   String?  @db.Uuid
  expiresAt     DateTime
  createdAt     DateTime @default(now())

  client OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OAuthToken {
  /// Access token value (opaque random string)
  token        String    @id
  refreshToken String?   @unique
  clientId     String    @db.Uuid
  userId       String    @db.Uuid
  /// Tool scope for this credential: "context" or "full" (see User.mcpScope).
  scope        String    @default("context")
  /// Workspace this connection is confined to; null = all workspaces.
  /// Chosen once on the consent screen — a coding agent pinned here can
  /// never act in (or even see context from) another workspace.
  workspaceId  String?   @db.Uuid
  expiresAt    DateTime
  createdAt    DateTime  @default(now())

  client OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model WorkspaceInvite {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @db.Uuid
  maxUses     Int      @default(1)
  usesCount   Int      @default(0)
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}
